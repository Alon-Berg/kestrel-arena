diff --git a/src/timemanager.cpp b/src/timemanager.cpp
index 64576b0..1d78270 100644
--- a/src/timemanager.cpp
+++ b/src/timemanager.cpp
@@ -22,5 +22,10 @@ Time optimumTime(int64_t availableTime, int inc, int movestogo)
     // dont use more than 50% of total time available
     time.maximum = static_cast<int64_t>(std::min(2.0 * time.optimum, 0.5 * availableTime));
 
+    // 0 means "no limit" to the search: with less than about 50 ms on the clock both values rounded down to 0 and
+    // the engine searched until it was stopped from outside (a flag fell). At least 1 ms.
+    time.optimum = std::max(time.optimum, int64_t(1));
+    time.maximum = std::max(time.maximum, int64_t(1));
